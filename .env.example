MY_EMAIL_ADDRESS=your-email@example.com
MY_EMAIL_APP_PASSWORD=your-gmail-app-password
FROM_EMAIL=
TO_EMAIL=

# Codex enrichment
CODEX_BIN=codex
CODEX_MODEL=gpt-5.6-luna
CODEX_REASONING_EFFORT=low
CODEX_CONCURRENCY=1
CODEX_TIMEOUT_SECONDS=120
CODEX_RETRIES=2
CODEX_TIMEZONE=America/New_York
# CODEX_MAX_NEW_JOBS=0
# CODEX_DRY_RUN=0

# Optional: INFO, WARNING, ERROR
LOG_LEVEL=INFO
